{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jbruns/homelab-components//renovate/repo-default#repo-ci-v1.1.0"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "third_party/retool/fixtures/**"
  ],
  "packageRules": [
    {
      "description": "The setup-agent-skills wrapper's own PR, apart from the repo-ci group the preset puts every Repo Tooling repo tag in",
      "matchFileNames": [
        "tools/agent-skills/setup-agent-skills"
      ],
      "groupName": "Repo Tooling agent-skills"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The clone lists and metadata Selection reads, pinned to a commit of upstream's main; the clone-list-pin workflow then writes the new archive's sha256",
      "managerFilePatterns": [
        "/^third_party/clone-lists/pins\\.toml$/"
      ],
      "matchStrings": [
        "\\[clone_lists\\]\\nrepository = \"(?<depName>[^\"]+)\"\\nbranch = \"(?<currentValue>[^\"]+)\"\\ncommit = \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "The MAME release the image builds chdman from, for CHD builds; CI's tests export the same chdman",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\w+=(?<currentValue>\\S+)"
      ],
      "versioningTemplate": "regex:^mame(?<major>\\d)(?<minor>\\d+)$"
    }
  ]
}
