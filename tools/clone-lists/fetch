#!/bin/sh
# Fetches the clone lists, metadata, MIAs and RetroAchievements data the Selection engine reads, at the commit
# third_party/clone-lists/pins.toml pins, and checks the archive against the pinned sha256.
#
#   tools/clone-lists/fetch [DEST]   unpack into DEST (default .clone-lists in the repository); does nothing
#                                    when DEST already holds the pinned commit
#   tools/clone-lists/fetch pin      write the sha256 of the pinned commit's archive into pins.toml
#
# DEST then holds config/internal-config.json, clonelists/, metadata/, mias/, retroachievements/, the
# upstream LICENSE and a `commit` file naming the commit. Needs curl, tar and sha256sum (or shasum).
set -eu

repo=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd)
pins="$repo/third_party/clone-lists/pins.toml"

fail() {
    echo "fetch: $*" >&2
    exit 1
}

pin() {
    value=$(sed -n "s/^$1 = \"\\(.*\\)\"\$/\\1/p" "$pins")
    [ -n "$value" ] || fail "$pins has no $1"
    printf '%s\n' "$value"
}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | cut -d' ' -f1
    else
        shasum -a 256 "$1" | cut -d' ' -f1
    fi
}

repository=$(pin repository)
commit=$(pin commit)
url="$repository/archive/$commit.tar.gz"

download() {
    curl --fail --silent --show-error --location --retry 3 --max-time 300 --output "$1" "$url"
}

if [ "${1:-}" = pin ]; then
    archive="$repo/.clone-lists.pin.tar.gz"
    trap 'rm -f "$archive"' EXIT
    download "$archive"
    digest=$(sha256 "$archive")
    [ "$(grep -c '^archive_sha256 = "[0-9a-f]*"$' "$pins")" = 1 ] ||
        fail "$pins needs exactly one archive_sha256 line"
    sed "s/^archive_sha256 = \"[0-9a-f]*\"\$/archive_sha256 = \"$digest\"/" "$pins" >"$pins.new"
    mv "$pins.new" "$pins"
    echo "clone-list archive for $commit: $digest"
    exit 0
fi

dest=${1:-"$repo/.clone-lists"}
if [ -f "$dest/commit" ] && [ "$(cat "$dest/commit")" = "$commit" ]; then
    echo "$dest already holds the clone lists at $commit"
    exit 0
fi

expected=$(pin archive_sha256)
work="$dest.partial"
rm -rf "$work"
mkdir -p "$work/unpacked"
trap 'rm -rf "$work"' EXIT
download "$work/archive.tar.gz"
actual=$(sha256 "$work/archive.tar.gz")
[ "$actual" = "$expected" ] ||
    fail "the clone-list archive does not match pins.toml archive_sha256 ($actual)"

tar -xzf "$work/archive.tar.gz" -C "$work/unpacked" --strip-components=1
out="$work/out"
mkdir -p "$out/config"
cp "$work/unpacked/config/internal-config.json" "$out/config/"
cp "$work/unpacked/LICENSE" "$out/LICENSE"
for dir in clonelists metadata mias retroachievements; do
    if [ -d "$work/unpacked/$dir" ]; then
        cp -R "$work/unpacked/$dir" "$out/$dir"
    else
        mkdir "$out/$dir"
    fi
done
printf '%s\n' "$commit" >"$out/commit"

rm -rf "$dest"
mv "$out" "$dest"
echo "fetched the clone lists at $commit into $dest"
